# ============================================================
# AI网文写作智能体 - 环境配置（全部可选）
# ============================================================
# 注意：使用桌面应用（python src/run_complete.py）无需创建本文件。
# 请在 设置 → LLM 页面直接填入你的 API 密钥，即存即用。
#
# 本文件仅在以下场景有用：
#   1. 使用命令行入口 python src/main.py（无GUI，从环境变量读密钥）
#   2. 需要自定义数据/日志/向量库的存储路径
# 使用时：cp .env.example .env 然后按需填写。

# ------------------------------------------------------------
# LLM API密钥（命令行模式专用，GUI用户请忽略）
# ------------------------------------------------------------
# 智谱GLM（推荐：有免费额度）https://open.bigmodel.cn/
ZHIPUAI_API_KEY=
# DeepSeek https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# OpenAI https://platform.openai.com/
OPENAI_API_KEY=

# 默认提供商：zhipuai / deepseek / openai
DEFAULT_LLM_PROVIDER=zhipuai

# ------------------------------------------------------------
# 存储路径（可选，不填则使用默认值）
# ------------------------------------------------------------
# 向量数据库目录（默认 ./data/chromadb）
# CHROMA_PERSIST_DIRECTORY=./data/chromadb
# SQLite数据库路径（默认 ./data/novel.db）
# SQLITE_DATABASE_PATH=./data/novel.db
# 日志（默认 INFO / ./logs/app.log）
# LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log
